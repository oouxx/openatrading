{
  "permissions": {
    "deny": [
      "Read(target/**)",
      "Read(dist/**)",
      "Read(downloads/**)",
      "Read(.git/**)",
      "Read(node_modules/**)",
      "Read(bun.lock)",
      "Bash(find / -name *)",
      "Bash(find /usr *)",
      "Bash(find /etc *)",
      "Bash(find /var *)"
    ],
    "allow": [
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_context",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_status"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/load-pending.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
