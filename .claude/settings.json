{
  "permissions": {
    "deny": [
      "Read(target/**)",
      "Read(dist/**)",
      "Read(downloads/**)",
      "Read(.git/**)",
      "Read(node_modules/**)",
      "Read(bun.lock)",
      "Bash(find / -name *)",
      "Bash(find /usr *)",
      "Bash(find /etc *)",
      "Bash(find /var *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-changes.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/load-pending.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
