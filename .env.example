# OpenATrading 环境变量模板
#
# 复制为 .env（已在 .gitignore 中，不要提交）：
#     cp .env.example .env
#
# 加载顺序：~/.atrading/.env → {cwd}/.atrading/.env（后者覆盖前者）
# config.toml 里用 ${VAR} 引用这里的变量。

# ── 数据源：韭研公社（需要登录的接口）───────────────────────
JIUYAN_PHONE=
JIUYAN_PASSWORD=
# 接口签名密钥。不再内置在代码里（公开仓库里的常量等于全网公开），
# 需要由使用者自己提供；缺失时相关数据源会直接报错而不是静默失败。
JIUYAN_SECRET=
# ── 项目 Skills：韭研板块异动 / 市场情报 ───────────────────
# Skills 自行获取动态签名，不经过 Rust。约 10 分钟失效。
JIUYAN_SESSION_TOKEN=
JIUYAN_TIMESTAMP=
JIUYAN_TOKEN=

# ── 通知渠道（可选，配了哪个就推哪个）─────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
LARK_APP_ID=
LARK_APP_SECRET=
LARK_RECEIVE_ID=

# ── LLM provider（也可在 Web 面板「设置 → Agent」里填）─────
# 写在 .env 里意味着整个进程可读；面板里保存的凭据落在
# ~/.atrading/agent/auth.json（权限 0600）。
OPENROUTER_API_KEY=

# ── 部署 ────────────────────────────────────────────────
# 部署走 GitHub Actions（.github/workflows/deploy.yml），本文件不再参与部署。
# 服务器侧的路径/凭据由仓库变量与服务器上的文件提供：
#   ATRADING_ENV_FILE       默认 /opt/openatrading/.env
#   ATRADING_HOST_HOME      默认 /opt/openatrading/atrading
#   ATRADING_DOWNLOADS_DIR  默认 /opt/openatrading/downloads
#   ATRADING_CERTS_DIR      默认 /opt/openatrading/certs
