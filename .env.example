# OpenATrading 环境变量模板
#
# 复制为 .env（已在 .gitignore 中，不要提交）：
#     cp .env.example .env
#
# 加载顺序：~/.atrading/.env → {cwd}/.atrading/.env（后者覆盖前者）
# config.toml 里用 ${VAR} 引用这里的变量。

# ── 数据源：韭研公社（需要登录的接口）───────────────────────
JIUYAN_PHONE=
JIUYAN_PASSWORD=
# 接口签名密钥。不再内置在代码里（公开仓库里的常量等于全网公开），
# 需要由使用者自己提供；缺失时相关数据源会直接报错而不是静默失败。
JIUYAN_SECRET=
# 可选：首次登录用的初始 token
JIUYAN_INIT_TOKEN=

# ── 通知渠道（可选，配了哪个就推哪个）─────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
LARK_APP_ID=
LARK_APP_SECRET=
LARK_RECEIVE_ID=

# ── LLM provider（也可在 Web 面板「设置 → Agent」里填）─────
# 写在 .env 里意味着整个进程可读；面板里保存的凭据落在
# ~/.atrading/agent/auth.json（权限 0600）。
OPENROUTER_API_KEY=

# ── 部署（只给 deploy.sh 用，不要提交具体值）───────────────
# DEPLOY_HOST=root@your-server
# DEPLOY_REMOTE_DIR=/root/openatrading
# DEPLOY_BRANCH=main
# 上传 GitHub Release / 拉私有依赖用
# GITHUB_TOKEN=
