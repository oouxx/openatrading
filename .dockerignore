*.db
*.db-shm
*.db-wal
certs/
downloads/
reports/
dist/
src/dist/
src/node_modules/
node_modules/
target/
.git/
.github/
.claude/
.codex/
.agents/
.pi-rs/
.gitignore
docker-compose.ci.yaml
*.log
