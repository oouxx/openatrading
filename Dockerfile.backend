# Build Rust backend
FROM rust:1.88-bookworm AS builder
WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates/core/Cargo.toml crates/core/
COPY crates/cli/Cargo.toml crates/cli/
COPY crates/web/Cargo.toml crates/web/
COPY crates/wasm/Cargo.toml crates/wasm/
COPY src-tauri/Cargo.toml src-tauri/

RUN mkdir -p crates/core/src crates/cli/src crates/web/src crates/wasm/src && \
    echo "fn main() {}" > crates/cli/src/main.rs && \
    echo "fn main() {}" > crates/web/src/main.rs && \
    echo "pub fn dummy() {}" > crates/wasm/src/lib.rs && \
    echo "pub fn dummy() {}" > crates/core/src/lib.rs
RUN cargo build --release -p trending-agent-web
RUN rm -rf crates/*/src target/release/.fingerprint/trending-agent*

COPY crates/ crates/
RUN touch crates/web/src/main.rs && cargo build --release -p trending-agent-web

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/trending-agent-web /app/
EXPOSE 8080
CMD ["./trending-agent-web"]
