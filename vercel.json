{
  "installCommand": "cd src && bun install --frozen-lockfile",
  "buildCommand": "cd src && bun run build:vercel",
  "outputDirectory": "src/dist",
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/data/report.json", "dest": "/data/report.json" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
