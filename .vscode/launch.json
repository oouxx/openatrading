{
  "version": "0.2.0",
  "configurations": [
    // ── CLI ──────────────────────────────────────────
    {
      "name": "CLI: run (full report)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin=trading-agent", "--package=trading-agent-cli"]
      },
      "args": [],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "CLI: run --ai (report + AI)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin=trading-agent", "--package=trading-agent-cli"]
      },
      "args": ["run", "--ai"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "CLI: limit-up",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin=trading-agent", "--package=trading-agent-cli"]
      },
      "args": ["limit-up"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "CLI: overview",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin=trading-agent", "--package=trading-agent-cli"]
      },
      "args": ["overview"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "CLI: sentiment",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin=trading-agent", "--package=trading-agent-cli"]
      },
      "args": ["sentiment"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "CLI: agent (REPL)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin=trading-agent", "--package=trading-agent-cli"]
      },
      "args": ["agent"],
      "envFile": "${workspaceFolder}/.env"
    },

    // ── Web Server ───────────────────────────────────
    {
      "name": "Web: run server",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin=trading-agent-web", "--package=trading-agent-web"]
      },
      "args": [],
      "envFile": "${workspaceFolder}/.env"
    },

    // ── Tests ────────────────────────────────────────
    {
      "name": "Test: core",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--package=openatrading-core"]
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Test: cli",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--package=trading-agent-cli"]
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Test: web",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--package=trading-agent-web"]
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Test: all (including integration)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--", "--ignored"]
      },
      "envFile": "${workspaceFolder}/.env"
    },

    // ── Vue Frontend ─────────────────────────────────
    {
      "name": "Frontend: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/src/*"
      }
    },
    {
      "name": "Frontend: Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src"
    }
  ]
}
