{
  "productName": "openatrading",
  "version": "0.10.7",
  "identifier": "com.openatrading.app",
  "build": {
    "beforeDevCommand": "cd src && bun run dev",
    "beforeBuildCommand": "cd src && bun install && bun run build:tauri",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../src/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://* tauri:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://*"
    },
    "windows": [
      {
        "title": "OpenATrading",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "AI-native A\u80a1\u77ed\u7ebf\u4ea4\u6613\u51b3\u7b56\u5de5\u4f5c\u53f0",
    "longDescription": "OpenATrading \u662f\u4e00\u4e2a AI-native A \u80a1\u77ed\u7ebf\u4ea4\u6613\u51b3\u7b56\u5de5\u4f5c\u53f0\u3002\u63d0\u4f9b\u5e02\u573a\u60c5\u7eea\u5206\u6790\u3001\u9f99\u5934\u7ed3\u6784\u8ffd\u8e2a\u3001\u8d44\u91d1\u884c\u4e3a\u76d1\u6d4b\u3001\u70ed\u70b9\u6269\u6563\u5206\u6790\u7b49\u529f\u80fd\u3002",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "appimage": {}
    },
    "windows": {}
  }
}
