{
  "productName": "trending-agent-tauri",
  "version": "0.1.0",
  "identifier": "com.trending-agent.app",
  "build": {
    "beforeDevCommand": "cd ../src && bun run dev",
    "beforeBuildCommand": "cd ../src && bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../src/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "Trending Agent",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ]
  }
}